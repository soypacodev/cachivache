<!--
    Estilos de todos los controles. Los colores llegan por DynamicResource
    desde el diccionario de tema, así que este archivo no cambia al pasar de
    oscuro a claro.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================= CONVERSORES =================
        El de WPF: $true pasa a Visible y $false a Collapsed. Lo usa la cabecera
        de grupo para plegarse.
    -->
    <BooleanToVisibilityConverter x:Key="BoolAVisible"/>

    <!--
        ================= TIPOGRAFÍA =================
        Escala de seis tamaños; no añadir valores sueltos:

          28  Titulo          título de página, uno por panel
          20  Cifra           números grandes (espacio recuperado)
          15  TituloTarjeta   cabecera de una tarjeta
          13  (por defecto)   texto normal
          12  TextoMenor      apoyo, detalles, pies
          11  Seccion         rótulo de sección, en mayúsculas

        Pesos: Normal para leer, SemiBold para titular. No se usa Bold.
    -->
    <FontFamily x:Key="FuenteBase">Segoe UI Variable Text, Segoe UI, Inter, system-ui</FontFamily>
    <FontFamily x:Key="FuenteMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
        Anillo de foco propio: el rectángulo punteado del sistema apenas se ve
        sobre fondo oscuro. Va por fuera del control (Margin negativo) para no
        tapar el borde.
    -->
    <Style x:Key="AnilloFoco">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="8" Margin="-3" BorderThickness="2"
                            BorderBrush="{DynamicResource Acento}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <!-- Un párrafo pierde legibilidad por encima de unos 90 caracteres por línea. -->
        <Setter Property="MaxWidth"   Value="760"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="Seccion" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}"/>
        <Setter Property="Margin"     Value="0,0,0,12"/>
    </Style>

    <!-- Cabecera de tarjeta, para no repetir FontSize y FontWeight en el XAML. -->
    <Style x:Key="TituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TextoMenor" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoTenue}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Cifra" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Exito}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!--
        ================= BOTONES =================
        El ratón y la pulsación cambian el color, no la opacidad: con opacidad
        el resultado depende del fondo. Cada estilo declara sus tres colores.
    -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="FontFamily"  Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Padding"     Value="16,10"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AnilloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fondo" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background"  Value="{DynamicResource Acento}"/>
        <!--
            Del tema y no "#FFFFFF" fijo: sobre el acento claro del tema oscuro el
            texto blanco no se lee.
        -->
        <Setter Property="Foreground"  Value="{DynamicResource TextoSobreAcento}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AcentoFuerte}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AcentoFuerte}"/>
                <Setter Property="Opacity"    Value="0.85"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background"  Value="{DynamicResource Peligro}"/>
        <Setter Property="Foreground"  Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.78"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background"  Value="{DynamicResource FondoTarjeta}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Texto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource FondoElevado}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextoTenue}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource FondoHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotonTexto" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextoSuave}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight"  Value="Normal"/>
        <Setter Property="Padding"     Value="12,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FondoHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botones de la barra de título -->
    <Style x:Key="BotonVentana" TargetType="Button">
        <Setter Property="Width"      Value="46"/>
        <Setter Property="Height"     Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource FondoHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        El botón de cerrar se pone rojo al pasar el ratón, como en Windows. Se
        cambia el Stroke del aspa: Foreground no lo usa esta plantilla.
    -->
    <Style x:Key="BotonCerrar" TargetType="Button" BasedOn="{StaticResource BotonVentana}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo" Background="Transparent">
                        <ContentPresenter x:Name="aspa" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="#E81123"/>
                            <Setter TargetName="aspa" Property="TextElement.Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= NAVEGACIÓN LATERAL ================= -->
    <Style x:Key="BotonNavegacion" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Margin"     Value="12,2"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AnilloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="fondo" Background="Transparent" CornerRadius="6" Height="38"/>
                        <!--
                            Marca del elemento elegido, pegada al borde izquierdo, para
                            distinguirlo de un vistazo.
                        -->
                        <Border x:Name="marca" Width="3" Height="20" CornerRadius="2"
                                HorizontalAlignment="Left" Background="{DynamicResource Acento}"
                                Opacity="0"/>
                        <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource FondoHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource AcentoTenue}"/>
                            <Setter TargetName="marca" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ================= TARJETAS =================
        Dos radios en todo el programa: 10 para superficies (tarjetas, menús,
        diálogos) y 6 para controles (botones, campos, filas).
    -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource FondoTarjeta}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="Padding"         Value="16"/>
    </Style>

    <!-- ================= CASILLAS ================= -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AnilloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="caja" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource FondoElevado}"
                                BorderBrush="{DynamicResource Borde}" BorderThickness="1.5"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <!--
                                El tick toma su color del tema: sobre el acento
                                claro del tema oscuro, un tick blanco no se ve.
                            -->
                            <Path x:Name="tick" Width="11" Height="11" Stretch="Uniform"
                                  Data="M3,8 L6.5,11.5 L13,4" Opacity="0"
                                  Stroke="{DynamicResource TextoSobreAcento}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caja" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                        </Trigger>
                        <!--
                            IsChecked va después de IsMouseOver: con dos
                            disparadores sobre la misma propiedad gana el
                            último, y marcada debe mantener el borde del
                            relleno.
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caja" Property="Background"  Value="{DynamicResource Acento}"/>
                            <Setter TargetName="caja" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                            <Setter TargetName="tick" Property="Opacity"     Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= CAMPOS DE TEXTO ================= -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily"  Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Foreground"  Value="{DynamicResource Texto}"/>
        <Setter Property="CaretBrush"  Value="{DynamicResource Acento}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Acento}"/>
        <Setter Property="Padding"     Value="12,8"/>
        <Setter Property="MinHeight"   Value="36"/>
        <!--
            Sin anillo de foco: el campo ya lo indica con su borde.
        -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="marco" CornerRadius="6"
                            Background="{DynamicResource FondoElevado}"
                            BorderBrush="{DynamicResource Borde}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="marco" Property="BorderBrush" Value="{DynamicResource TextoTenue}"/>
                        </Trigger>
                        <!--
                            Con foco manda el acento, también con el ratón
                            encima (por eso va el último). El borde pasa a 1.5;
                            SnapsToDevicePixels evita que el medio píxel se vea
                            borroso.
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="marco" Property="BorderBrush"     Value="{DynamicResource Acento}"/>
                            <Setter TargetName="marco" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="marco" Property="Background"      Value="{DynamicResource FondoTarjeta}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Consola" TargetType="TextBox">
        <Setter Property="FontFamily"    Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="Padding"       Value="16"/>
        <Setter Property="Foreground"    Value="{DynamicResource TextoSuave}"/>
        <Setter Property="Background"    Value="{DynamicResource FondoTarjeta}"/>
        <Setter Property="BorderBrush"   Value="{DynamicResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"       Value="14"/>
        <Setter Property="IsReadOnly"    Value="True"/>
        <Setter Property="TextWrapping"  Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ================= BARRA DE PROGRESO ================= -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"     Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
        <Setter Property="Background" Value="{DynamicResource FondoElevado}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= DESPLEGABLES ================= -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="MinHeight"  Value="36"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AnilloFoco}"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Background" Value="{DynamicResource FondoElevado}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Padding"    Value="11,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="marcoCombo" Background="{DynamicResource FondoElevado}" CornerRadius="6"
                                            BorderBrush="{DynamicResource Borde}" BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Data="M0,0 L4,4 L8,0"
                                                  Stroke="{DynamicResource TextoTenue}" StrokeThickness="1.6"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="marcoCombo" Property="BorderBrush" Value="{DynamicResource TextoTenue}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="marcoCombo" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource FondoTarjeta}" CornerRadius="10" Margin="0,6,0,0"
                                    BorderBrush="{DynamicResource Borde}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="280">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Padding"    Value="12,9"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="fondo" Background="Transparent" CornerRadius="6" Margin="4,2">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource FondoHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource AcentoTenue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= BARRAS DE DESPLAZAMIENTO ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width"      Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <!--
                                    El hueco lateral va en el Margin del Thumb y no en
                                    su plantilla, para poder cambiarlo con TargetName
                                    cuando la barra es horizontal.
                                -->
                                <Thumb x:Name="PART_Thumb" Margin="2,0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource FondoHover}"
                                                    CornerRadius="5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                            En horizontal se invierten dos cosas: la dirección
                            de la pista (IsDirectionReversed solo es válido en
                            vertical) y el margen del tirador.
                        -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="PART_Thumb" Property="Margin" Value="0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--
            Este disparador va en Style.Triggers y no en ControlTemplate.Triggers:
            dentro de la plantilla, el Width="10" de este estilo prevalecía y la
            barra horizontal quedaba de 10 px de ancho. Precedencia en WPF, de más
            fuerte a menos: valor local, disparadores de estilo, disparadores de
            plantilla, Setter de estilo.
        -->

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"  Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= LISTA DE RESULTADOS ================= -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="BorderThickness"       Value="0"/>
        <Setter Property="RowBackground"         Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="GridLinesVisibility"   Value="None"/>
        <Setter Property="HeadersVisibility"     Value="Column"/>
        <Setter Property="AutoGenerateColumns"   Value="False"/>
        <Setter Property="CanUserAddRows"        Value="False"/>
        <Setter Property="CanUserDeleteRows"     Value="False"/>
        <Setter Property="CanUserResizeRows"     Value="False"/>
        <Setter Property="SelectionMode"         Value="Extended"/>
        <Setter Property="SelectionUnit"         Value="FullRow"/>
        <!--
            MinRowHeight y no RowHeight: con altura fija la columna "qué pasa si se
            borra" (aviso, efecto, comando y estado) se recortaba sin aviso. Las
            filas cortas siguen midiendo 52 y solo crecen las que lo necesitan.

            A vigilar: la altura variable complica el desplazamiento virtualizado y
            con miles de filas puede ir a saltos (comprobación manual, no se puede
            medir sin WPF). La alternativa sería volver a la altura fija y dejar el
            texto completo solo en la ayuda emergente, que ya lo incluye.
        -->
        <Setter Property="MinRowHeight"          Value="52"/>
        <Setter Property="Foreground"            Value="{DynamicResource Texto}"/>
        <Setter Property="FontFamily"            Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"              Value="13"/>
        <Setter Property="EnableRowVirtualization"    Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode"         Value="Recycling"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextoTenue}"/>
        <Setter Property="FontFamily"      Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="14,10"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Borde}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!--
        No hay estilo implícito para DataGridRow: la tabla declara su propio
        RowStyle sin BasedOn en Panel.Resultados.xaml, que lo anularía.
    -->

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource Texto}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ================= ETIQUETAS DE RIESGO =================
        Un punto de color y la palabra al lado, sin fondo ni borde. El color
        sigue indicando el riesgo.
    -->
    <!--
        Punto de 9 y texto de 12: el riesgo es el dato de seguridad más
        importante de cada fila y no debe ser el texto más pequeño de la
        interfaz. 12 forma parte de la escala tipográfica. Los rótulos de
        estructura (Seccion, cabeceras de columna) se quedan en 11.
    -->
    <Style x:Key="Punto" TargetType="Ellipse">
        <Setter Property="Width"    Value="9"/>
        <Setter Property="Height"   Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextoEtiqueta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ================= SEPARADOR ================= -->
    <Style x:Key="Separador" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Borde}"/>
        <Setter Property="Margin"     Value="0,16"/>
    </Style>

    <!--
        ================= LISTAS DE TARJETAS PULSABLES =================
        ListBox (y no ItemsControl) para poder pulsar una fila con
        SelectionChanged, como el resto de la ventana. La plantilla del
        contenedor es solo un ContentPresenter: el resaltado y el rectángulo de
        foco de ListBoxItem taparían la tarjeta.
    -->
    <Style x:Key="ListaTarjetas" TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!--
            Dentro del ScrollViewer del panel: sin esto tendría su propia barra.
        -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin"  Value="0"/>
                    <Setter Property="Cursor"  Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fila de la lista de informes guardados, compartida por las tres listas
        (HTML, CSV y JSON).
    -->
    <DataTemplate x:Key="PlantillaInforme">
        <Border Style="{StaticResource Tarjeta}" Padding="13" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detalle}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextoTenue}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Tamano}" FontSize="12" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextoTenue}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ================= AYUDAS EMERGENTES ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource FondoElevado}" CornerRadius="7"
                            BorderBrush="{DynamicResource Borde}" BorderThickness="1"
                            Padding="11,8" MaxWidth="440">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize"   Value="12"/>
    </Style>
</ResourceDictionary>
