root = true

# LF en todo el repositorio, como fija .gitattributes. Una prueba compara
# el XAML montado byte a byte con un oraculo, y un editor que guardara
# CRLF la haria fallar.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psd1,psm1}]
indent_size = 4
max_line_length = 100

[*.xaml]
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2
trim_trailing_whitespace = false

[*.bat]
end_of_line = lf
